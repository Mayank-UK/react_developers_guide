# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

# Umami analytics (PUBLIC values — the beacon URL + website id are visible in
# the served page source anyway, so these ride repository variables, never
# secrets). Vite bakes import.meta.env at BUILD time, so they must be ENV
# before `npm run build`. Empty defaults (= unset) keep analytics a complete
# no-op: no script tag injected, track() sends nothing.
ARG VITE_UMAMI_SRC=""
ARG VITE_UMAMI_ID=""
ENV VITE_UMAMI_SRC=$VITE_UMAMI_SRC
ENV VITE_UMAMI_ID=$VITE_UMAMI_ID

# Grafana Faro crash telemetry (PUBLIC values — same discipline as the Umami
# block above). Empty defaults (= unset) keep the beacon a complete no-op:
# no script tag injected, nothing initialized.
ARG VITE_FARO_URL=""
ARG VITE_FARO_APP=""
ENV VITE_FARO_URL=$VITE_FARO_URL
ENV VITE_FARO_APP=$VITE_FARO_APP

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:alpine AS runner

# COPY paths are still relative to the build context (project root),
# so .docker/nginx/default.conf correctly references our file.
COPY .docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# Drop privileges: nginx listens on the unprivileged port 8080 so the whole
# process can run as the non-root `nginx` user (no privileged port binding).
# Non-root prep, while this RUN still has root — a non-root master cannot
# create these itself (stock image leaves them root-owned):
# - the five temp/cache dirs nginx mkdirs at startup;
# - the pid file moves to /tmp (world-writable); /var/run stays root-owned;
# - the static tree is owned by `nginx` (the stock entrypoint skips its
#   default chown when it is not root).
RUN mkdir -p /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp \
        /var/cache/nginx/fastcgi_temp /var/cache/nginx/uwsgi_temp \
        /var/cache/nginx/scgi_temp \
    && chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html \
    && sed -i 's|pid  */\(var/\)\?run/nginx\.pid|pid /tmp/nginx.pid|' /etc/nginx/nginx.conf

USER nginx

# Liveness probe — the container should answer on :8080.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:8080/ || exit 1

EXPOSE 8080