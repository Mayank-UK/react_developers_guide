# Development environment (Vite default `--mode development`).
# Fakes + failure injection are on so the error pipeline can be exercised
# without a real backend. Override per-launch via the Exception-handling screen.
VITE_BASE_URL=https://jsonplaceholder.typicode.com
VITE_USE_FAKE_API=true
VITE_USE_FAKE_DB=true
VITE_ENABLE_LOGS=true
VITE_API_SCENARIO=success
VITE_DB_SCENARIO=success
