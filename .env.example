# Build-time environment for Vite — everything here is PUBLIC by design:
# values are baked into the served bundle. Per-mode files (.env.development /
# .env.production / .env.staging) carry the app config; this example documents
# the optional keys.

# Self-hosted Umami analytics — BOTH must be non-empty to enable it; empty
# (default) means analytics is a complete no-op. CI passes these as Docker
# build-args from the VITE_UMAMI_* repository variables.
VITE_UMAMI_SRC=
VITE_UMAMI_ID=

# Grafana Faro browser-crash telemetry canary (CDN IIFE bundle — no npm
# dependency). BOTH must be non-empty to enable it; leaving either empty is
# the default and means the beacon is a complete no-op (no script injected,
# nothing initialized). Production builds get these as Docker build-args
# from the VITE_FARO_* repository variables in CI.
#VITE_FARO_URL=https://faro.mayankcodeworks.com/collect
VITE_FARO_URL=
VITE_FARO_APP=
