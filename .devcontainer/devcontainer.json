// This attaches to the same container that is runnig the react application instead of creating a new container

{
    "name": "React Developers Guide",

    // Use existing Compose setup instead of creating its own container
    "dockerComposeFile": "../.docker/docker-compose.dev.yml",
    "service": "app",

    "workspaceFolder": "/app",

    "forwardPorts": [5173],

    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "ms-vscode.vscode-typescript-next"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode"
            }
        }
    }
}
